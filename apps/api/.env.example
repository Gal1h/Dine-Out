# Salin file ini menjadi .env lalu isi nilainya.
# Jangan pernah commit file .env.

DATABASE_URL="mysql://root:password@localhost:3306/dineout"

# String acak panjang, minimal 32 karakter. Contoh membuat:
# node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="ganti-dengan-string-acak-panjang"

# Kunci enkripsi AES-256-GCM untuk Gemini API key (32 byte, base64). Contoh membuat:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
GEMINI_ENC_KEY="ganti-dengan-32-byte-base64"

PORT=3001
WEB_ORIGIN="http://localhost:5173"
NODE_ENV=development
GEMINI_MODEL="gemini-2.5-flash"
LOG_LEVEL="info"
